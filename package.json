{
  "name": "shc",
  "version": "1.0.0",
  "private": true,
  "description": "SNES ROM header cleaner",
  "scripts": {
    "dev": "node scripts/dev.js",
    "watch": "node scripts/dev.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "npm run typecheck && node scripts/build.js",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "clean-css": "^5.3.3",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
